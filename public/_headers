# Response headers for the static assets Workers serves, replacing the `headers`
# block vercel.json used to carry. Workers parses this file and never serves it
# as an asset itself. It lives in public/ so Vite copies it into dist/ on build.

# The stale-tab update check fetches this every two minutes and compares it
# against the build stamp compiled into the running bundle. Cached, it would
# keep answering with the build the tab is already on and no update would ever
# be reported.
/version.json
  Cache-Control: no-store, max-age=0

# Everything Vite emits under /assets/ carries a content hash in its filename,
# so a given URL can never change. Cloudflare's default for static assets is
# `max-age=0, must-revalidate`, which would make every one of these revalidate
# on each load — Vercel marked them immutable and this keeps that behaviour.
# Deliberately scoped to /assets/: sw.js and workbox-*.js sit at the root and
# must stay revalidated, or a new build could never take over.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell opts out of Cloudflare's Bot Fight Mode script injection.
# Bot Fight Mode appends an inline <script> to every HTML page, and the CSP in
# index.html (correctly) has no 'unsafe-inline', so every page load logged a
# CSP violation and the injected script never ran anyway. Cloudflare can't
# nonce it for a <meta> CSP, and a hash won't work because the script embeds a
# per-request ray id. `no-transform` is Cloudflare's documented opt-out. The
# rest of the value restates the platform default, since setting Cache-Control
# here replaces it rather than appending. Scoped to the HTML only: no-transform
# also disables edge compression, which the JS bundles need and a 2 KB shell
# doesn't.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# SPA deep links are answered with index.html by not_found_handling, but the
# rules above match on the request path, not the file served. So every
# top-level client route needs its own rule. Add one here when you add a route
# to the router, or reloads on that route log the CSP error again (harmless,
# but that's what this block is for).
/exam*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/friends*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/messages*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/rooms*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/shared/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/study*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
