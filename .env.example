# Convex
VITE_CONVEX_URL=

# Clerk (authentication)
VITE_CLERK_PUBLISHABLE_KEY=

# Cloudflare R2 (public bucket URL, used to build permanent editor-image links)
VITE_R2_PUBLIC_URL=

# The following are set in the Convex Dashboard, NOT in .env.local:
# ASSEMBLYAI_API_KEY=     (for real-time transcription)
# ANTHROPIC_API_KEY=      (for AI note generation + study tools)
# CLERK_JWT_ISSUER_DOMAIN= (for Clerk JWT validation)
# GITHUB_TOKEN=           (GitHub PAT with public_repo scope — for bug report issue creation)
# GITHUB_REPO=            (owner/repo format e.g. lmdrew96/scribecat-v3)
# R2_TOKEN=               (Cloudflare API token for the R2 bucket)
# R2_ACCESS_KEY_ID=       (R2 S3-compatible access key)
# R2_SECRET_ACCESS_KEY=   (R2 S3-compatible secret key)
# R2_ENDPOINT=            (https://ACCOUNT_ID.r2.cloudflarestorage.com)
# R2_BUCKET=              (R2 bucket name)
